{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FootballData": {
    "BaseUrl": "https://api.football-data.org/v4/",
    "Competitions": [ "PL", "PD", "BL1", "SA", "FL1", "CL" ],
    "SyncIntervalHours": 12
  },
  "Jwt": {
    "Issuer": "FutNight",
    "Audience": "FutNightApp",
    "ExpiryMinutes": 1440
  }
}
