# Kopiér denne fil til ".env" og udfyld værdierne.
# ".env" er git-ignoreret og må aldrig committes.

# ---------- PostgreSQL (bruges af docker-compose) ----------
POSTGRES_USER=futnight
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=futnight

# ---------- Connection string til backend ----------
# Backend læser denne (matcher værdierne ovenfor).
# I .NET kan den sættes som miljøvariabel med dobbelt-underscore:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=futnight;Username=futnight;Password=change_me_local_dev
